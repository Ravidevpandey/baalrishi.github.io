rules_version = '2';

// Security rules for the Antarodaya website (reviews + customer accounts).
// Deploy: Firebase console → Firestore Database → Rules → paste this file → Publish.
// Keep the admin list in sync with assets/js/firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return verified() && request.auth.token.email in ['pandeyravidev2@gmail.com'];
    }
    function isOwner(data) {
      return signedIn() && data.uid == request.auth.uid;
    }
    // Unpublished reviews and profiles carry an expireAt about 30 days ahead; the daily cleanup
    // workflow (.github/workflows/cleanup.yml) deletes documents once expireAt has passed.
    function expiresIn30Days(d) {
      return d.expireAt is timestamp
        && d.expireAt > request.time + duration.value(29, 'd')
        && d.expireAt < request.time + duration.value(31, 'd');
    }
    function validReview(d) {
      return d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 1000
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.get('service', '') is string && d.get('service', '').size() <= 60
        && d.get('lang', 'hi') in ['hi', 'en'];
    }

    // Customer reviews. New and edited reviews stay "pending" until the admin publishes them.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isOwner(resource.data) || isAdmin();

      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'rating', 'text', 'service', 'lang', 'status', 'createdAt', 'expireAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'rating', 'text', 'status', 'createdAt', 'expireAt'])
        && expiresIn30Days(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && validReview(request.resource.data);

      allow update: if isAdmin()
        || (verified() && isOwner(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rating', 'text', 'service', 'status', 'updatedAt'])
            && request.resource.data.status == 'pending'
            && request.resource.data.updatedAt == request.time
            && validReview(request.resource.data));

      allow delete: if isAdmin() || isOwner(resource.data);
    }

    // Consultation bookings. The document id is the slot, "YYYY-MM-DD_HHMM" (IST), so a slot can be
    // booked only once. Each booking is written together with a public /slots doc (date and time only)
    // that lets the booking form grey out taken times without revealing who booked them.
    function slotTimes() {
      return ['09:00', '09:30', '10:00', '10:30', '11:00', '11:30',
              '14:00', '14:30', '15:00', '15:30', '16:00', '16:30',
              '20:00', '20:30', '21:00', '21:30', '22:00', '22:30', '23:00', '23:30'];
    }
    function slotDay(d) {
      return timestamp.date(int(d.date[0:4]), int(d.date[5:7]), int(d.date[8:10]));
    }
    function validSlot(slotId, d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time in slotTimes()
        && slotId == d.date + '_' + d.time.replace(':', '')
        && slotDay(d).dayOfWeek() in [6, 7]
        && slotDay(d) > request.time - duration.value(1, 'd')
        && slotDay(d) < request.time + duration.value(62, 'd')
        && d.expireAt is timestamp
        && d.expireAt > request.time
        && d.expireAt < request.time + duration.value(95, 'd');
    }
    match /bookings/{slotId} {
      allow read: if isAdmin() || isOwner(resource.data);

      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'service', 'option', 'mode', 'note', 'date', 'time', 'lang', 'status', 'createdAt', 'expireAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'phone', 'email', 'service', 'mode', 'date', 'time', 'status', 'createdAt', 'expireAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[+]?[0-9 ()-]{8,20}$')
        && request.resource.data['service'] is string && request.resource.data['service'].size() <= 60
        && request.resource.data.get('option', '') is string && request.resource.data.get('option', '').size() <= 100
        && request.resource.data.mode in ['whatsapp', 'phone', 'video']
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500
        && request.resource.data.get('lang', 'hi') in ['hi', 'en']
        && validSlot(slotId, request.resource.data)
        && existsAfter(/databases/$(database)/documents/slots/$(slotId));

      // The admin confirms a booking or marks it done.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['requested', 'confirmed', 'done'];

      // Cancelling deletes the booking and its slot together, freeing the time.
      allow delete: if isAdmin() || isOwner(resource.data);
    }
    match /slots/{slotId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['date', 'time', 'expireAt'])
        && getAfter(/databases/$(database)/documents/bookings/$(slotId)).data.uid == request.auth.uid
        && validSlot(slotId, request.resource.data);
      allow delete: if isAdmin()
        || (signedIn()
            && get(/databases/$(database)/documents/bookings/$(slotId)).data.uid == request.auth.uid
            && !existsAfter(/databases/$(database)/documents/bookings/$(slotId)));
    }

    // Customer profiles, readable by the customer and the admin.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'provider', 'createdAt', 'lastLoginAt', 'expireAt'])
        && request.resource.data.createdAt == request.time
        && expiresIn30Days(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.photoURL.matches('^(https://[a-z0-9.-]+[.]googleusercontent[.]com/.*)?$');

      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'photoURL', 'provider', 'lastLoginAt', 'expireAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['expireAt']) || expiresIn30Days(request.resource.data))
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.photoURL.matches('^(https://[a-z0-9.-]+[.]googleusercontent[.]com/.*)?$');

      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
  }
}
